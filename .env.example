# Cognito / OIDC configuration
# For Vite, prefix variables with VITE_ (e.g. VITE_REACT_APP_CLIENT_ID)
# Use the Cognito Hosted UI issuer domain as authority.

VITE_REACT_APP_COGNITO_AUTHORITY=https://<your-cognito-hosted-ui-domain>.auth.us-east-1.amazoncognito.com
VITE_REACT_APP_CLIENT_ID=<your-client-id>
VITE_REACT_APP_REDIRECT_URI=http://localhost:5173 # Update with your app's redirect URI for Vite
VITE_REACT_APP_LOGOUT_URI=http://localhost:3000 # Update with your app's logout URI
VITE_REACT_APP_OAUTH_SCOPES="openid email phone"

# Optional - if using Vite replace the keys with VITE_ prefix, e.g.
# VITE_REACT_APP_CLIENT_ID=<your-client-id>
