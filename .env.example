# Cognito / OIDC configuration
# For Vite, prefix variables with VITE_ (e.g. VITE_REACT_APP_CLIENT_ID)

REACT_APP_COGNITO_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<your-user-pool-id>
REACT_APP_CLIENT_ID=<your-client-id>
REACT_APP_REDIRECT_URI=http://localhost:3000 # Update with your app's redirect URI
REACT_APP_LOGOUT_URI=http://localhost:3000 # Update with your app's logout URI
REACT_APP_OAUTH_SCOPES="openid email phone"

# Optional - if using Vite replace the keys with VITE_ prefix, e.g.
# VITE_REACT_APP_CLIENT_ID=<your-client-id>
